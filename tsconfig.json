{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/components/use-saved-projects": [
        "./components/use-local-projects.ts"
      ],
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "app/**/*.tsx",
    "components/**/*.tsx",
    "components/**/*.ts",
    "lib/**/*.ts",
    "public-app/**/*.tsx",
    "tests/public-render.tsx"
  ],
  "exclude": [
    "node_modules",
    "public-dist",
    ".sites-runtime"
  ]
}
